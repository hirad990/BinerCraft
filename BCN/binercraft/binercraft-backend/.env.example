PORT=3000
FRONTEND_URL=https://binercraft.ir
API_PREFIX=/loloh

# PostgreSQL - use your cPanel PostgreSQL database credentials
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
PGSSL=false

# Admin authentication - NEVER commit the real password/secret
ADMIN_USERNAME=hirad990
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
AUTH_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional Bale payment integration
BALE_WALLET_TOKEN=YOUR_BALE_TOKEN_HERE
BALE_PAYMENT_URL=YOUR_BALE_PAYMENT_URL_HERE
BALE_CALLBACK_URL=https://binercraft.ir/loloh/api/bale-callback
